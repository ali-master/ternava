{
  "name": "ternava-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Ternava workspace. The public npm package @usex/ternava lives in packages/mini.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-master/ternava.git"
  },
  "scripts": {
    "build": "bun run --cwd packages/mini build",
    "test": "bun run --cwd packages/mini test && node --test scripts/tests/*.test.mjs examples/tests/*.test.mjs",
    "build:engine": "bash scripts/build-engine.sh",
    "verify:release": "bash scripts/verify-release.sh",
    "eval": "bash scripts/run-eval.sh",
    "check:brand": "node --test scripts/tests/branding.test.mjs"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "examples/emoji-search",
    "examples/odyssey-cli"
  ]
}
