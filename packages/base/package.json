{
  "name": "@usex/ternava-base",
  "version": "0.1.1",
  "description": "Ternava internal base architecture",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-master/ternava.git",
    "directory": "packages/base"
  },
  "homepage": "https://ternava.usestrict.dev/",
  "bugs": {
    "url": "https://github.com/ali-master/ternava/issues"
  },
  "keywords": [
    "embeddings",
    "semantic-search",
    "vector-search",
    "nearest-neighbor",
    "on-device",
    "edge",
    "wasm",
    "bitnet",
    "ternary",
    "minilm",
    "sentence-embeddings"
  ],
  "type": "commonjs",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": {
        "import": "./src/index.mjs",
        "require": "./src/index.js"
      },
      "browser": "./src/index.browser.mjs",
      "default": "./src/index.browser.mjs"
    },
    "./web": {
      "types": "./pkg-web/tern_engine.d.ts",
      "default": "./pkg-web/tern_engine.js"
    },
    "./runtime": {
      "types": "./pkg-web/index.d.mts",
      "default": "./pkg-web/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "pkg-node/",
    "pkg-bundler/",
    "pkg-web/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "PKG=packages/base bash ../../scripts/build-engine.sh",
    "test": "node --test tests/*.test.js"
  },
  "private": true
}
